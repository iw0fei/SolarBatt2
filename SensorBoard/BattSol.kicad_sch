	(text_box "Vr=Kr*Vr_raw,  Vb=Kb*Vb_raw\nV1=k1*(V1_raw - Vr1_raw)*1000   (in Ampere, 1mV=1A)\nV2=k2*(V2_raw - Vr2_raw)*1000   (in Ampere, 1mV=1A)\n\nParametri da impostare:\n  Kr=Vr0/Vr0_raw   [Vr0_raw / Vr0 valori alla taratura]\n  Vb=Vb0/Vb0_raw   [Vb0_raw / Vb0 valori alla taratura]\n\nCon Vs1=0 e Vs2=0\n  Vr1_raw          Valore letto con Vs1 = 0\n  Vr2_raw          Valore letto con Vs2 = 0\nCon Vs1<>0 e Vs2<>0\n  k1=Vs1/(V1_raw - Vr1_raw)\n  k2=Vs2/(V2_raw - Vr2_raw)"
		(exclude_from_sim no)
		(at 13.97 67.31 0)
		(size 68.58 31.75)
